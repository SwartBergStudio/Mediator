<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1510</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Fails pack if the public API breaks compatibility with the last published release. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>3.0.0</PackageValidationBaselineVersion>
    
    <!-- Versioning: set by the Release workflow from git tags (GitVersion). Local builds use the placeholder. -->
    <Version>0.0.0-dev</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>
    
    <!-- Package metadata -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>SwartBerg.Mediator</PackageId>
    <Authors>SwartBerg Studio</Authors>
    <Company>SwartBerg Studio</Company>
    <Product>SwartBerg.Mediator</Product>
    <Description>A high-performance mediator for .NET 8, 9 and 10: requests, commands, streaming (IAsyncEnumerable), pipeline behaviors, background notification processing and crash-safe persistence. MediatR-style interfaces with strongly-typed dispatch, ConfigureAwait(false) by default, and Native AOT support through the SwartBerg.Mediator.SourceGenerator package.</Description>
    <Summary>High-performance .NET 8+ mediator with streaming, background processing, persistence, and built-in deadlock protection</Summary>
    <PackageTags>mediator;cqrs;command;query;notification;streaming;iasyncenumerable;background-processing;persistence;performance;net9;net10;high-performance;source-generator;native-aot;trimming;configureawait;ui-safe;aot;deadlock-safe</PackageTags>
    <PackageProjectUrl>https://github.com/SwartBergStudio/Mediator</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SwartBergStudio/Mediator.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/SwartBergStudio/Mediator/releases</PackageReleaseNotes>
    <Copyright>Copyright © SwartBerg Studio 2025</Copyright>
    
    <!-- Package ownership and trust -->
    <PackageOwners>SwartBerg Studio</PackageOwners>
    <RepositoryBranch>main</RepositoryBranch>
    <RepositoryCommit></RepositoryCommit>
    
    <!-- Source link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

  <!-- Ensure README is included in NuGet package when specified by PackageReadmeFile -->
  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>true</Pack>
      <PackagePath>README.md</PackagePath>
    </None>
    <None Include="..\..\assets\icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
  </ItemGroup>

</Project>

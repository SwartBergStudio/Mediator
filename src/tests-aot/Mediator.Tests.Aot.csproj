<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the full Mediator.Tests suite a second time in "AOT mode":
    - dynamic code is disabled (RuntimeFeature.IsDynamicCodeSupported == false), exactly as under Native AOT,
      so the mediator cannot fall back to MakeGenericType and Microsoft.Extensions.DependencyInjection uses its
      reflection-free activation path;
    - typed dispatchers come only from the source-generated AddMediatorHandlers() (see AotTestMode.cs).
    Any message type the generator misses makes the corresponding tests fail.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mediator.Tests</RootNamespace>
    <DefineConstants>$(DefineConstants);AOT_MODE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\tests\**\*.cs" Exclude="..\tests\bin\**;..\tests\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mediator\Mediator.csproj" />
    <ProjectReference Include="..\Mediator.SourceGenerator\Mediator.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

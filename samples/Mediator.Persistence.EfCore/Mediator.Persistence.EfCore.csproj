<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sample: EF Core-backed notification persistence. Copy the .cs files into your app; works with any EF Core
       relational provider (SQL Server, PostgreSQL, SQLite, ...). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- In an application this is: <PackageReference Include="SwartBerg.Mediator" Version="..." /> -->
    <ProjectReference Include="..\..\src\Mediator\Mediator.csproj" />
  </ItemGroup>

</Project>
